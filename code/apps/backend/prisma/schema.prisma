generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id           String               @id @default(cuid())
  amount       Decimal
  date         DateTime
  description  String
  merchant     String?
  account      String?
  notes        String?
  source       String
  categoryId   String?
  category     Category?            @relation(fields: [categoryId], references: [id])
  importedFrom ImportedTransaction?
  createdAt    DateTime             @default(now())
}

model Category {
  id                String                @id @default(cuid())
  name              String                @unique
  color             String
  monthlyBudget     Decimal?
  transactions      Transaction[]
  rules             CategoryRule[]
  aiSuggestions     ImportedTransaction[] @relation("AiCategory")
  recurringPatterns RecurringPattern[]
}

model RecurringPattern {
  id            String    @id @default(cuid())
  description   String    @unique
  typicalDay    Int
  typicalAmount Decimal
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ImportBatch {
  id         String                @id @default(cuid())
  filename   String
  uploadedAt DateTime              @default(now())
  status     String
  imported   ImportedTransaction[]
}

model ImportedTransaction {
  id             String       @id @default(cuid())
  batchId        String
  batch          ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rawDate        String
  rawDescription String
  rawAmount      Decimal
  aiCategoryId   String?
  aiCategory     Category?    @relation("AiCategory", fields: [aiCategoryId], references: [id])
  aiCategorized  Boolean      @default(false)
  transactionId  String?      @unique
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
}

model CategoryRule {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  keyword    String
}

/// aiApiKey is stored in plaintext in the SQLite file.
/// Known limitation: consider migrating to the OS keychain (e.g. keytar) if
/// the app is distributed more broadly.
model AppSettings {
  id         String @id @default("singleton")
  aiProvider String @default("openrouter")
  aiApiKey   String @default("")
  aiModel    String @default("")
}
