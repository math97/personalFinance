{
  "name": "ember-finance",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.copyFileSync('src/splash.html','dist/splash.html');fs.copyFileSync('assets/icon.png','dist/ember-icon.png')\"",
